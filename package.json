{
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "verify": "node scripts/verify-setup.js",
    "diagram:usecases:png": "mmdc -i diagrams/usecase-edumod.mmd -o public/img/usecase-edumod.png -b transparent -w 1600",
    "diagram:usecases:svg": "mmdc -i diagrams/usecase-edumod.mmd -o public/img/usecase-edumod.svg -b transparent -w 1600",
    "diagram:usecases:pdf": "mmdc -i diagrams/usecase-edumod.mmd -o public/img/usecase-edumod.pdf -w 1600",
    "diagram:usecases": "npm run diagram:usecases:png && npm run diagram:usecases:svg && npm run diagram:usecases:pdf",
    "diagram:usecases:uml:png": "node scripts/render_puml_kroki.js png",
    "diagram:usecases:uml:svg": "node scripts/render_puml_kroki.js svg",
    "diagram:usecases:uml:pdf": "node scripts/render_puml_kroki.js pdf",
    "diagram:usecases:uml": "npm run diagram:usecases:uml:png && npm run diagram:usecases:uml:svg && npm run diagram:usecases:uml:pdf"
  },
  "dependencies": {
    "@sentry/node": "^7.120.4",
    "@sentry/tracing": "^7.120.4",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.1",
    "node-fetch": "^3.3.2",
    "node-gtts": "^2.0.2",
    "nodemailer": "^7.0.6",
    "nodemon": "^3.1.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "puppeteer": "^24.22.3",
    "qrcode": "^1.5.4",
    "winston": "^3.17.0"
