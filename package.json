  "devDependencies": {
    "@kroki/cli": "^0.3.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@playwright/test": "^1.55.1",
    "jest": "^30.1.3",
    "supertest": "^7.1.4"
  }
